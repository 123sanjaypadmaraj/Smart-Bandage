# Copy to .env (gitignored -- see .gitignore) and fill in what you need.
# Loaded automatically by backend/app/config.py via python-dotenv; never
# overrides a variable already set in the real environment. Nothing here
# is required -- every value has a zero-setup default, see config.py.

# Phase 10 AI analysis (backend/app/routers/ai.py). Unset: GET/POST
# /devices/{id}/ai/* return 503, nothing else in the app is affected.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Origins allowed to call the API (comma-separated). Defaults to just the
# dashboard's dev port (5173) -- add the mobile web dev port (8081, from
# `cd mobile && npm run web`) when running both frontends against this
# backend at once.
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Uncomment to point at Postgres instead of the default local SQLite file.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/smart_bandage

# Uncomment for a real deployment -- see backend/app/config.py:Settings.validate()
# ENVIRONMENT=production
# JWT_SECRET=
# ^ generate with `python scripts/generate_secret.py`, then set it via your
#   platform's secret store at deploy time -- never write the real value
#   into this file (or any file that ends up on a real box).
